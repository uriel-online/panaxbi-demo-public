{
  "server": {
    "request": "https://server.panaxbi.com/gateway.asp?action=report",
    "login": "POST https://server.panaxbi.com/gateway.asp?action=login",
    "logout": "POST https://server.panaxbi.com/gateway.asp?action=logout",
    "taxan": "https://server.panaxbi.com/gateway.asp?action=soaddi-balances"
  },
  "sources": {
    "#": "#shell",
    "#login": "login.xml",
    "#sitemap": "navigation.xml",
    "#tablero_direccion": {
      "dashboardRequest": {
        "command": "[#panax].[getBalancedScorecard]"
      }
    },
    "#estado_resultados_mensual": {
      "progressiveRequest": {
        "command": "#panax.getData",
        "@get_un": 1,
        "@get_n1": 1,
        "@get_budget": 0
      }
    },
    "#taxan/income-mxn": {
      "server:taxan": {
        "action": "soaddi-balances",
        "view": "income-mxn"
      }
    },
    "#taxan/income-usd": {
      "server:taxan": {
        "action": "soaddi-balances",
        "view": "income-usd"
      }
    },
    "#taxan/balance-mxn": {
      "server:taxan": {
        "action": "soaddi-balances",
        "view": "balance-mxn"
      }
    },
    "#taxan/balance-usd": {
      "server:taxan": {
        "action": "soaddi-balances",
        "view": "balance-usd"
      }
    }
  },
  "settings": {
    "#shell": {
      "hash": ""
    },
    "#server:login||#server:logout||#server:request": {
      "credentials": "include"
    },
    "#server:request||#dashboardRequest||#polizas||#capital_trabajo||#flujo_efectivo||#razones_financieras||#concentrado_er_balance||#productividad_individual": {
      "trackers": [
        {
          "label": "Cargando reporte…"
        }
      ]
    },
    "#taxan/income-mxn||#taxan/income-usd||#taxan/balance-mxn||#taxan/balance-usd": {
      "stylesheets": [
        {
          "href": "taxan-periodos.xslt",
          "target": "@#shell main"
        }
      ],
      "resumable": false
    },
    "#server:taxan": {
      "credentials": "include",
      "cache": "no-store",
      "resumable": false,
      "rejectCodes": 400,
      "headers": {
        "Accept": "application/xml"
      },
      "trackers": [
        {
          "label": "Cargando reporte…"
        }
      ]
    }
  }
}
