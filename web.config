<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment=".git" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".xslt" />
      <mimeMap fileExtension=".xslt" mimeType="application/xml" />
      <remove fileExtension=".xhtml" />
      <mimeMap fileExtension=".xhtml" mimeType="application/xhtml+xml" />
    </staticContent>
  </system.webServer>
</configuration>
